{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ShmupX Lite",
  "version": "0.1.10",
  "identifier": "com.shmupx.lite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "ShmupX Lite", "width": 420, "height": 860, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"]
  }
}
