{
  "name": "shmupx-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -Local",
    "build": "tsc && vite build",
    "test:ui": "node --test tests/ui-state.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-bundle.ps1 && tauri build --config src-tauri/tauri.bundle.conf.json"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
