{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ShmupX",
  "version": "0.1.22",
  "identifier": "com.shmupx.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ShmupX Client",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "maximized": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5NkZBMUQyQkU5RDg4RDQKUldUVWlKMiswcUZ2R1JIM0NJaGxZUTBZRjRwTDBUYkp1NXI1QlVpelBxMFFxb29JTldFSUpxV3IK",
      "endpoints": [
        "https://www.shmupx.com/api/client/update/{{target}}/{{arch}}/{{current_version}}?bundle={{bundle_type}}"
      ],
      "windows": {
        "installMode": "quiet"
      },
      "requireSignedVersion": true
    }
  }
}
