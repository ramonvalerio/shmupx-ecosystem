rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Prototype schema. Authentication owns credentials and verified email.
    // users/{uid}: private profile, only displayName (1..32), locale (pt-BR/en),
    //   createdAt and updatedAt timestamps. Document ID is the Firebase Auth UID.
    // publicProfiles/{uid}: server-published display name/avatar; no private fields.
    // games/{gameId}, events/{eventId}, seasons/{seasonId}: server-written;
    //   published bool controls visibility to authenticated clients.
    // gameplays/{runId}: server-owned record, ownerId is immutable Firebase UID;
    //   gameId, status, capture/analysis/result metadata, no raw video bytes.
    // wallets/{uid}: server-owned balance; wallets/{uid}/entries/{id}: ledger.
    // seasons/{id}/gameRankings/{gameId}/entries/{uid}: server-published rankings.
    // seasons/{id}/globalRankings/{uid}: server-published global ranking.
    // rooms/{gameId}/messages/{id}: game-room chat. Signed-in players read and post in
    //   published games' rooms; authorId/authorName must match the caller's own profile,
    //   createdAt is the server time, messages are immutable (no edit/delete by clients).
    // rooms/{gameId}/presence/{uid}: who joined the room. Each player writes only their own
    //   doc (name = profile displayName, state online|away|playing|live, lastSeen = server time; live
    //   adds liveVideoId and liveViewers) every
    //   30 s and deletes it on leaving the room; entries older than 75 s show as offline.
    // analysisJobs and all other paths: server-only. Admin SDK bypasses Rules;
    // backend validation and IAM remain mandatory for every server write.

    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function validUser(data) {
      return data.keys().hasAll(['displayName', 'locale', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'locale', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 32
        && data.locale in ['pt-BR', 'en']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function publishedGame(id) {
      return get(/databases/$(database)/documents/games/$(id)).data.published == true;
    }
    function validMessage(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'text', 'createdAt'])
        && data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
        && data.authorId == request.auth.uid
        && data.authorName is string
        && data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && data.text is string
        && data.text.size() >= 1 && data.text.size() <= 500
        && data.createdAt == request.time;
    }
    // state 'live' traz o vídeo do YouTube e quantos assistem (só nesse estado).
    function validPresence(data) {
      return data.keys().hasAll(['name', 'state', 'lastSeen'])
        && data.keys().hasOnly(['name', 'state', 'lastSeen', 'liveVideoId', 'liveViewers'])
        && data.name == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && data.state in ['online', 'away', 'playing', 'live']
        && data.lastSeen == request.time
        && (data.state == 'live') == data.keys().hasAll(['liveVideoId', 'liveViewers'])
        && (!data.keys().hasAny(['liveVideoId']) || (data.liveVideoId is string && data.liveVideoId.matches('^[A-Za-z0-9_-]{6,64}$')))
        && (!data.keys().hasAny(['liveViewers']) || (data.liveViewers is int && data.liveViewers >= 0 && data.liveViewers <= 100000000));
    }
    function publishedSeason(id) {
      return get(/databases/$(database)/documents/seasons/$(id)).data.published == true;
    }
    // Jogar no PC pelo celular: o ShmupX Lite grava o pedido (command), o Client do PC avisa que
    // está aberto (desktop) e responde (result). Só o dono; mapas pequenos, sem outros campos.
    function validRemote(data) {
      return data.keys().hasOnly(['desktop', 'command', 'result'])
        && (!data.keys().hasAny(['command']) || (data.command is map
          && data.command.keys().hasOnly(['id', 'action', 'gameId', 'platform', 'kind', 'mode', 'createdAt'])
          && data.command.id is string && data.command.id.size() <= 64
          && data.command.action in ['play', 'stop']
          && data.command.gameId is string && data.command.gameId.size() <= 128
          && (!data.command.keys().hasAny(['platform']) || data.command.platform in ['steam', 'emulator'])
          && (!data.command.keys().hasAny(['kind']) || data.command.kind in ['training', 'ranked'])
          && (!data.command.keys().hasAny(['mode']) || data.command.mode in ['highscore', '1cc', 'caravan'])
          && data.command.createdAt is int))
        && (!data.keys().hasAny(['result']) || (data.result is map
          && data.result.keys().hasOnly(['id', 'status', 'message', 'at'])
          && data.result.id is string && data.result.id.size() <= 64
          && data.result.status in ['started', 'failed', 'stopped']
          && (!data.result.keys().hasAny(['message']) || (data.result.message is string && data.result.message.size() <= 500))
          && data.result.at is int))
        && (!data.keys().hasAny(['desktop']) || (data.desktop is map
          && data.desktop.keys().hasOnly(['seenAt', 'owned'])
          && data.desktop.seenAt is int && data.desktop.owned is map
          && data.desktop.owned.size() <= 500));
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validUser(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if owns(uid) && validUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /games/{gameId} {
      allow read: if signedIn() && resource.data.published == true;
      allow write: if false;
    }
    match /events/{eventId} {
      allow read: if signedIn() && resource.data.published == true;
      allow write: if false;
    }
    match /seasons/{seasonId} {
      allow read: if signedIn() && resource.data.published == true;
      allow write: if false;
      match /gameRankings/{gameId}/entries/{uid} {
        allow read: if signedIn() && publishedSeason(seasonId);
        allow write: if false;
      }
      match /globalRankings/{uid} {
        allow read: if signedIn() && publishedSeason(seasonId);
        allow write: if false;
      }
    }
    match /rooms/{gameId}/messages/{messageId} {
      allow read: if signedIn() && publishedGame(gameId);
      allow create: if signedIn() && publishedGame(gameId) && validMessage(request.resource.data);
      allow update, delete: if false;
    }
    match /rooms/{gameId}/presence/{uid} {
      allow read: if signedIn() && publishedGame(gameId);
      allow create, update: if owns(uid) && publishedGame(gameId) && validPresence(request.resource.data);
      allow delete: if owns(uid);
    }
    match /remoteLaunch/{uid} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid) && validRemote(request.resource.data);
    }
    match /gameplays/{runId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }
    match /wallets/{uid} {
      allow read: if owns(uid);
      allow write: if false;
      match /entries/{entryId} {
        allow read: if owns(uid);
        allow write: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
