# Modelo das variáveis do backend em desenvolvimento (lido por scripts\start-dev.ps1).
# NÃO preencha aqui. Copie para %USERPROFILE%\.secrets\shmupx-backend.env (fora do repositório),
# preencha lá e mantenha uma cópia no gerenciador de senhas.

FIREBASE_PROJECT_ID=shmupx-project-id

# JSON da conta de serviço do Firebase (fora do repositório). Só o nome do arquivo basta se ele
# estiver na mesma pasta deste .env; senão, use o caminho completo.
GOOGLE_APPLICATION_CREDENTIALS=nome-do-arquivo.json

# Clients OAuth "Desktop" do Google. Os IDs são públicos; os secrets, não.
GOOGLE_DESKTOP_CLIENT_ID=230979440400-tieeiqsacgv0addabunn6kfpao927m55.apps.googleusercontent.com
GOOGLE_DESKTOP_CLIENT_SECRET=
GOOGLE_LAB_CLIENT_ID=230979440400-i3or3qvhiamrlrsbq1uoa49pmlceodg8.apps.googleusercontent.com
GOOGLE_LAB_CLIENT_SECRET=

# Contas administradoras (Lab e rotas /api/admin), separadas por vírgula.
ADMIN_EMAILS=admin@example.com,outro-admin@example.com

# Canal oficial da ShmupX no YouTube: uid da conta ShmupX que conectou o canal oficial em
# Configurações › Integrações do Client. As lives Ranked que entram no top 3 são publicadas nele.
# Opcional: vazio, a run entra no ranking normalmente, mas a live não é publicada.
SHMUPX_YOUTUBE_CANAL_UID=

# Avisos de versão do Client por e-mail (Amazon SES). Opcional: sem EMAIL_FROM e sem a role da AWS
# (AWS_SECRETS_ROLE_ARN, só no Cloud Run), só o aviso no Client. O remetente precisa ser do domínio
# verificado no SES (shmupx-infra/envs/backend-prod/ses.tf).
EMAIL_FROM=ShmupX <avisos@seu-dominio.com>
